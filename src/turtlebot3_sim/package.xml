<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>turtlebot3_sim</name>
  <version>1.0.0</version>
  <description>TurtleBot3 simulation launch files and Gazebo worlds</description>
  <maintainer email="robot@autonomy.local">Autonomy Stack</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>gazebo_ros</depend>
  <depend>turtlebot3_gazebo</depend>
  <depend>turtlebot3_description</depend>
  <depend>robot_state_publisher</depend>
  <depend>rviz2</depend>
