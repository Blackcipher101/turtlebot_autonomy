<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>semantic_graph</name>
  <version>1.0.0</version>
  <description>NetworkX-based semantic memory graph with ROS2 service interface</description>
  <maintainer email="robot@autonomy.local">Autonomy Stack</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>semantic_msgs</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
